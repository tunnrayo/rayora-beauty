NODE_ENV=development
PORT=4000
# The website address allowed to call this API
WEB_ORIGIN=http://localhost:3000

# PostgreSQL connection string
DATABASE_URL=
# Long random text (32+ characters) used to sign login tokens. Never share it.
AUTH_SECRET=

# First admin account. Created or updated by `npm run create-admin`.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Payments: leave empty for the demo payment mode. Add a key to switch to Paystack.
PAYSTACK_SECRET_KEY=

# Hugging Face (server only). Needed for image generation and the shopping assistant.
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Order emails (optional). Without these, emails are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM=Rayora Beauty <orders@yourdomain.com>
